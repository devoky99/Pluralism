<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- QEMU nutzt Apples Hypervisor.framework (-accel hvf). Funktioniert mit Ad-hoc-Signatur. -->
	<key>com.apple.security.hypervisor</key>
	<true/>
	<!-- vmnet ohne Root (-netdev vmnet-shared/vmnet-host). Auf macOS 27 genügt dieses Entitlement,
	     das nur auf Antrag vergebene com.apple.vm.networking ist nicht nötig (pluralism-netcheck). -->
	<key>com.apple.security.virtualization</key>
	<true/>
</dict>
</plist>
