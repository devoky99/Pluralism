# Versionen der mitgelieferten Laufzeit (QEMU und swtpm).
# Bei Änderungen baut die CI die Laufzeit neu (Cache-Schlüssel hängt von dieser Datei ab).

QEMU_VERSION=11.1.2
QEMU_URL=https://download.qemu.org/qemu-11.1.2.tar.xz
QEMU_SHA256=731b5681e4bb18be313231579b8efd0296c5b015fa36dc533874b639ba838016

# swtpm und libtpms kommen als fertige Homebrew-Pakete und werden relocatable gebündelt.
# Quellcode: https://github.com/stefanberger/swtpm (BSD-3-Clause),
#            https://github.com/stefanberger/libtpms (BSD-3-Clause)
SWTPM_FORMULA=swtpm

# Laufzeit-Revision: erhöhen, wenn sich Bauoptionen ändern.
RUNTIME_REVISION=2
